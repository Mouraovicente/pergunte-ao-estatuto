# Qual vector store usar: "memory" | "file" | "neo4j"
# Padrao quando nao definido: "file" na CLI (persiste entre execucoes) e "memory" na API
VECTOR_STORE=file

# Caminho do indice JSON usado quando VECTOR_STORE=file
VECTOR_STORE_FILE=.estatuto-index.json

# Qual gerador de respostas usar: "fake" (padrao, sem chave, resposta-template) ou "openrouter"
LLM=fake

# Necessario apenas quando LLM=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Necessario apenas quando VECTOR_STORE=neo4j (ver docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Porta da API HTTP (src/api.ts)
PORT=3000
