# Qual vector store usar: "memory" (padrao, sem dependencias externas) ou "neo4j"
VECTOR_STORE=memory

# Qual gerador de respostas usar: "fake" (padrao, sem chave, resposta-template) ou "openrouter"
LLM=fake

# Necessario apenas quando LLM=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Necessario apenas quando VECTOR_STORE=neo4j (ver docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Porta da API HTTP (src/api.ts)
PORT=3000
